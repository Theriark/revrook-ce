# Throwaway values for local compose and CI smoke tests only. They protect
# nothing. Never reuse them in a deployment: the Development deployment gets
# its own generated secrets from the deployment controller.
#
# FERNET_KEY below is the all-zero key (32 zero bytes, URL-safe base64).
SECRET_KEY=local-dev-only-secret-key-not-for-deployment
FERNET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# The password of the compose database (the db service and DATABASE_URL of web
# and worker). Letters and digits only, so it fits in DATABASE_URL as it is.
POSTGRES_PASSWORD=local-dev-only-not-a-secret
